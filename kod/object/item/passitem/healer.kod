////////////////////////////////////////////////////////////////////////////////
Healer is PassiveItem

constants:

   include blakston.khd

   // How far away (in rows/cols) another player can be.
   HEALER_RANGE = 3

resources:

   include healer.lkod

   healer_desc_rsc = "%s\n\nThis will help you feel better.%s"

   healer_use = "You feel better."
   healer_cant_use_on = "You can't heal %s%s."

classvars:

   viUse_type = ITEM_SINGLE_USE

properties:

   piHeal_min = 0
   piHeal_max = 0

messages:

   ReqNewApply(what = $,apply_on = $)
   {
      local iDistSq;

      // On ourselves, or on another player close by who can interact.
      if IsClass(apply_on,&User)
      {
         if apply_on = what
         {
            return TRUE;
         }

         if Send(apply_on,@GetOwner) = Send(what,@GetOwner)
            AND NOT Send(apply_on,@IsInCannotInteractMode)
         {
            iDistSq = Send(what,@SquaredDistanceTo,#what=apply_on);
            if iDistSq <> $
               AND iDistSq <= (HEALER_RANGE * HEALER_RANGE)
            {
               return TRUE;
            }
         }
      }

      Send(what,@MsgSendUser,#message_rsc=healer_cant_use_on, 
           #parm1=Send(apply_on,@GetIndef),#parm2=Send(apply_on,@GetName));

      return FALSE;
   }

   NewApplied(what = $,apply_on = $)
   {
      Send(apply_on,@MsgSendUser,#message_rsc=healer_use);
      Send(apply_on,@GainHealth,#amount=Random(piHeal_min,piHeal_max));

      piHits = piHits - 1;
      if piHits <= 0
      {
         Send(self,@Delete);
      }

      return;
   }


end
////////////////////////////////////////////////////////////////////////////////
